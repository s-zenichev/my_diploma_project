<?xml version='1.0' ?>
<launch>
<!-- Start world -->
<include file="$(find-pkg-share puma560_gazebo)/launch/start_world.launch.py"/>
<!-- Publish URDF file in robot_description topic -->
<include file="$(find-pkg-share ur_description)/launch/view_ur.launch.py">
    <arg name="ur_type" value="ur5e"/>
</include>
<!-- Start control system -->
<include file="$(find-pkg-share puma560_description)/launch/control_system.launch.py"/>
<!-- Start adapter service -->
<node pkg="ur_motion_planner" exec="motion_planner" output="screen"/>
<!-- Start MoveIt2 -->
<include file="$(find-pkg-share ur_motion_planner)/launch/move_group.launch.py">
    <arg name="use_sim_time" value="true"/>
</include>
<executable cmd="ros2 param set /move_group use_sim_time true" output="screen"/>
<!-- Read robot_description an dspawn in gazebo running sim -->
<include file="$(find-pkg-share puma560_gazebo)/launch/spawn_robot_description.launch.py"/>
</launch>
